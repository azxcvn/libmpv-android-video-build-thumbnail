+/**
+ * Fast seek-preview thumbnail, extracted by an independent FFmpeg decode
+ * instance that bypasses the playback pipeline completely (ported from
+ * mpvlibAndroid's thumbnail.cpp). The JavaVM required by FFmpeg's
+ * MediaCodec wrapper must already be registered through
+ * mpv_lavc_set_java_vm().
+ *
+ * @param path      video file path (local filesystem only)
+ * @param position  timestamp in seconds (0.0 = first frame)
+ * @param dimension larger side of the output image in pixels (1..4096)
+ * @param use_hwdec 1 to prefer MediaCodec with automatic software fallback
+ * @param out_data  receives a tightly packed RGBA8888 buffer, release it
+ *                  with mk_thumbnail_free()
+ * @param out_width  output width in pixels
+ * @param out_height output height in pixels
+ *
+ * @return 0 on success, a negative AVERROR otherwise
+ */
+MPV_EXPORT int mk_thumbnail_grab(const char *path, double position, int dimension,
+                                 int use_hwdec, unsigned char **out_data,
+                                 int *out_width, int *out_height);
+
+/**
+ * Release a buffer returned by mk_thumbnail_grab().
+ */
+MPV_EXPORT void mk_thumbnail_free(unsigned char *data);
+
+/**
+ * Drop the cached MediaCodec device context (it is re-created on demand).
+ */
+MPV_EXPORT void mk_thumbnail_clear_cache(void);
+
+
+
